// LLAMP-SPEC v1 | CURRENT_DECISIONS
// task: OPC-UA Node Browser | date: 2026-03-04

#what_changed
=packages/types/src/index.ts: OpcuaBrowseNode interface + OpcuaNodeClass const added
=lib/hooks/useOpcuaGateways.ts: useBrowseNodes mutation added (POST /opcua-gateways/:id/browse)
=app/opcua-gateways/_components/BrowseNodeItem.tsx: NEW — single lazy tree row component
=app/opcua-gateways/_components/OpcuaBrowseModal.tsx: NEW — full tree with lazy expand + multi-select
=app/opcua-gateways/_components/OpcuaGatewayModal.tsx: "Browse Server" button + handleBrowseConfirm

#tech_implications
~browse_api: POST /opcua-gateways/:id/browse returns flat children [{nodeId, browseName, displayName, nodeClass}]
~OpcuaNodeClass.Variable = 2 (selectable), OpcuaNodeClass.Object = 1 (expandable only)
~childrenCache: Map<nodeId, OpcuaBrowseNode[]> keyed per nodeId — avoids re-fetching on collapse/expand
~handleBrowseConfirm deduplicates by checking existing nodeMappings nodeId values before appending
~edit_mode_only: Browse button gated on !!gateway && !!gateway.id — safe for create flow

#constraints
!rule: Browse button only appears in edit mode (gateway.id required for API call)
~temporary_connection: Backend creates temp OPC-UA connection if gateway not currently running
~no_arch_changes: No backend changes — uses existing browse endpoint from ADR-036 scope

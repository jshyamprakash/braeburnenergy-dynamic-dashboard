# =============================================================================
# IoT Platform - Environment Variables
# =============================================================================
# Copy this file to .env and update with your actual values

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# MongoDB connection URI (requires replica set for Time Series Collections)
MONGODB_URI=mongodb://localhost:27017/iot_platform?replicaSet=rs0

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# API server port
PORT=3001

# API server host
HOST=0.0.0.0

# Node environment (development | production | test)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# API URL for frontend (public-facing)
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL for frontend (public-facing)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Optional: Production Settings
# -----------------------------------------------------------------------------
# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

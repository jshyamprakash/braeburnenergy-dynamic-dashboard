# =============================================================================
# IoT Platform - Environment Variables
# =============================================================================
# Copy this file to .env and update with your actual values

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# MongoDB connection URI (requires replica set for Time Series Collections)
MONGODB_URI=mongodb://localhost:27017/iot_platform?replicaSet=rs0

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# API server port
PORT=3001

# API server host
HOST=0.0.0.0

# Node environment (development | production | test)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# API URL for frontend (public-facing)
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL for frontend (public-facing)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Streaming Infrastructure (ADR-043) — required for gateway data pipeline
# -----------------------------------------------------------------------------
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# -----------------------------------------------------------------------------
# License Configuration (ADR-048 / ADR-050)
# -----------------------------------------------------------------------------
# LICENSE_KEY: JWT string generated by the license generator CLI.
# Leave empty in development — all modules are enabled automatically.
LICENSE_KEY=

# RS256 (production — ADR-050): asymmetric RSA keypair.
#   Vendor holds the private key; public key is baked into the Docker image.
#   Generate keypair: pnpm --filter @repo/license-cli run generate-keypair
#   Build image:      docker build --build-arg LICENSE_PUBLIC_KEY="$(cat public.pem)" .
#   Sign key:         pnpm --filter @repo/license-cli run generate -- --algorithm rs256 \
#                       --private-key private.pem --customer "Acme" --modules combustion_dl
LICENSE_PUBLIC_KEY=

# HS256 (dev/staging fallback): only used when LICENSE_PUBLIC_KEY is empty.
LICENSE_SECRET=license-secret-change-in-production

# -----------------------------------------------------------------------------
# Optional: Production Settings
# -----------------------------------------------------------------------------
# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

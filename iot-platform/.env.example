# =============================================================================
# IoT Platform - Environment Variables
# =============================================================================
# Copy this file to .env and update with your actual values

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# MongoDB connection URI (requires replica set for Time Series Collections)
MONGODB_URI=mongodb://localhost:27017/iot_platform?replicaSet=rs0

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# API server port
PORT=3001

# API server host
HOST=0.0.0.0

# Node environment (development | production | test)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# API URL for frontend (public-facing)
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL for frontend (public-facing)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Streaming Infrastructure (ADR-043) — required for gateway data pipeline
# -----------------------------------------------------------------------------
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# -----------------------------------------------------------------------------
# License Configuration (ADR-048 / ADR-050)
# -----------------------------------------------------------------------------
# LICENSE_KEY: JWT string generated by the license generator CLI.
# Leave empty in development — all modules are enabled automatically.
LICENSE_KEY=

# RS256 (production — ADR-050): asymmetric RSA keypair.
#   Vendor holds the private key; public key is baked into the Docker image.
#   Generate keypair: pnpm --filter @repo/license-cli run generate-keypair
#   Build image:      docker build --build-arg LICENSE_PUBLIC_KEY="$(cat public.pem)" .
#   Sign key:         pnpm --filter @repo/license-cli run generate -- --algorithm rs256 \
#                       --private-key private.pem --customer "Acme" --modules combustion_dl
LICENSE_PUBLIC_KEY=

# HS256 (dev/staging fallback): only used when LICENSE_PUBLIC_KEY is empty.
LICENSE_SECRET=license-secret-change-in-production

# -----------------------------------------------------------------------------
# Security — REQUIRED in production
# -----------------------------------------------------------------------------
# JWT signing secret. Generate a secure value:
#   openssl rand -base64 64
JWT_SECRET=change-this-insecure-default-in-production

# JWT token lifetimes
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# bcrypt cost factor (10 = ~100ms, 12 = ~400ms)
BCRYPT_ROUNDS=10

# CORS allowed origin for the API (single value; set to your frontend domain)
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# SuperAdmin keypair auth (ADR-052)
# -----------------------------------------------------------------------------
# SUPERADMIN_PUBLIC_KEY is baked into the Docker image at build time (not runtime).
# 1. Choose a strong passphrase (keep it secret — equivalent to a private key)
# 2. Derive the public key:
#      SUPERADMIN_PASSPHRASE="your-passphrase" \
#        pnpm --filter @repo/license-cli run superadmin-derive
# 3. Copy the printed public key PEM and pass it to docker build:
#      docker build --build-arg SUPERADMIN_PUBLIC_KEY="<pem>" -t kosmos-api ./
#    OR set here for docker-compose build:
SUPERADMIN_PUBLIC_KEY=

# Username and email for the seeded SuperAdmin account (created on first boot)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@local.dev

# -----------------------------------------------------------------------------
# Frontend URLs (baked into Next.js bundle at build time)
# -----------------------------------------------------------------------------
# Set to your public-facing API and WebSocket URLs before running docker compose build
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

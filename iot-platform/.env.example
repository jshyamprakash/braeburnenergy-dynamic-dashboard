# =============================================================================
# IoT Platform - Environment Variables
# =============================================================================
# Copy this file to .env and update with your actual values

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL password for production deployment
DB_PASSWORD=secure_password_change_me

# Full database URL (used by Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://iot_platform:secure_password_change_me@localhost:5432/iot_platform?schema=public

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# API server port
PORT=3001

# API server host
HOST=0.0.0.0

# Node environment (development | production | test)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# API URL for frontend (public-facing)
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL for frontend (public-facing)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Optional: Production Settings
# -----------------------------------------------------------------------------
# Enable Prisma query logging (true | false)
# PRISMA_QUERY_LOG=false

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

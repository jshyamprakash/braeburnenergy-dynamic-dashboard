# Environment
NODE_ENV=development

# Server Configuration
PORT=3001
HOST=0.0.0.0

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/iot_platform?replicaSet=rs0

# WebSocket Configuration
WS_PORT=3002
WS_CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Security (REQUIRED in production — generate with: openssl rand -base64 64)
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:3000

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Streaming Infrastructure (ADR-043)
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# License Configuration (ADR-048 / ADR-050)
# Leave LICENSE_KEY empty in development — all modules enabled automatically.
LICENSE_KEY=

# RS256 (production): set LICENSE_PUBLIC_KEY — baked into Docker image at build time.
# Generate keypair: pnpm --filter @repo/license-cli run generate-keypair
# LICENSE_SECRET is only used when LICENSE_PUBLIC_KEY is empty (HS256 fallback for dev/staging).
LICENSE_PUBLIC_KEY=
LICENSE_SECRET=license-secret-change-in-production

# SuperAdmin keypair auth (ADR-052)
# SUPERADMIN_PUBLIC_KEY is baked at Docker build time (ARG in Dockerfile) — do NOT set here at runtime.
# Derive with: SUPERADMIN_PASSPHRASE="..." pnpm --filter @repo/license-cli run superadmin-derive
# SUPERADMIN_PUBLIC_KEY=  ← set via docker build --build-arg, not .env

# Username / email for the seeded SuperAdmin record (created on first boot if absent)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@local.dev

# BE Agent AI Chat Configuration (ADR-058)
# Supports any OpenAI-compatible endpoint.
# Leave AI_CHAT_ENDPOINT empty to run in stub mode (no external calls).
# Compatible with: Ollama (http://localhost:11434/v1), vLLM, Azure OpenAI, Groq, OpenRouter, etc.
AI_CHAT_ENDPOINT=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini

# SMTP Configuration (ADR-059 — Alarm Notification Channels)
# Leave SMTP_HOST empty to run in stub mode — email channels skip silently.
# Compatible with: SendGrid, Mailgun, AWS SES, local Mailhog, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
